DIAG: arm64: report the page behind a userspace SIGILL

Temporary, not for upstream.

procd dies of SIGILL shortly after ath12k starts its datapath, which means
a page it was executing from got overwritten. Which page, and what
replaced it, is the whole question -- and answering it by reserving memory
and counting panics across many boots is slow and weak.

Report it directly. The hook sits in force_signal_inject() rather than in
do_el0_undef(), because arm64 raises SIGILL from five places and the
backtrace's el0_undef frame does not pin down which: several el0_*
handlers have identical bodies and fold together, so the unwinder can name
the wrong one. An earlier version of this patch hooked do_el0_undef() and
printed nothing at all on a panicking boot, which is what established
that the signal comes from somewhere else.

Print the faulting PC, the mapping it belongs to, the physical page behind
it from walking the process page tables, and the instructions either side
of the PC. The bytes that replaced the code should identify the writer.

Signed-off-by: Hideo Sumi <hideo.sumi@mugops.com>
---
--- a/arch/arm64/kernel/traps.c
+++ b/arch/arm64/kernel/traps.c
@@ -406,11 +406,107 @@
 	return 0;
 }
 
+/*
+ * DIAG: report what a userspace SIGILL was executing.
+ *
+ * Hooked at force_signal_inject() rather than in do_el0_undef(), because
+ * arm64 raises SIGILL from five places and the backtrace's el0_undef frame
+ * does not pin down which: several el0_* handlers have identical bodies and
+ * fold together, so the unwinder can name the wrong one. Reporting here
+ * covers do_el0_undef, do_el0_bti, do_el0_fpac, do_el0_mops and do_el0_sys
+ * alike, and says which code was raised.
+ *
+ * A userspace SIGILL means the page the process was executing from got
+ * overwritten. Print the faulting PC, the mapping it belongs to, the
+ * physical page behind it, and the bytes around the PC, so the corrupting
+ * write can be identified from a single occurrence instead of by repeating
+ * the boot and counting.
+ */
+static void ath_diag_report_sigill(int signal, int code, unsigned long address)
+{
+	struct pt_regs *regs = current_pt_regs();
+	struct mm_struct *mm = current->mm;
+	struct vm_area_struct *vma;
+	unsigned long pc = instruction_pointer(regs);
+	phys_addr_t phys = 0;
+	u32 buf[8];
+	int i, n = 0;
+
+	if (signal != SIGILL)
+		return;
+
+	pr_err("DIAG sigill: comm=%s pid=%d code=%d addr=%016lx pc=%016lx\n",
+	       current->comm, current->pid, code, address, pc);
+
+	if (!mm)
+		return;
+
+	if (!mmap_read_trylock(mm)) {
+		pr_err("DIAG sigill: could not take mmap lock\n");
+		return;
+	}
+
+	vma = find_vma(mm, pc);
+	if (vma) {
+		pr_err("DIAG sigill: vma %016lx-%016lx flags=%lx file=%s\n",
+		       vma->vm_start, vma->vm_end, vma->vm_flags,
+		       vma->vm_file ? (const char *)vma->vm_file->f_path.dentry->d_name.name
+				    : "(anon)");
+	} else {
+		pr_err("DIAG sigill: no vma covers pc\n");
+	}
+
+	{
+		pgd_t *pgd = pgd_offset(mm, pc);
+		p4d_t *p4d;
+		pud_t *pud;
+		pmd_t *pmd;
+		pte_t *pte;
+
+		if (!pgd_none(*pgd) && !pgd_bad(*pgd)) {
+			p4d = p4d_offset(pgd, pc);
+			if (!p4d_none(*p4d) && !p4d_bad(*p4d)) {
+				pud = pud_offset(p4d, pc);
+				if (!pud_none(*pud) && !pud_bad(*pud)) {
+					pmd = pmd_offset(pud, pc);
+					if (!pmd_none(*pmd) && !pmd_bad(*pmd)) {
+						pte = pte_offset_kernel(pmd, pc);
+						if (pte && pte_present(*pte))
+							phys = (pte_pfn(*pte) << PAGE_SHIFT) |
+							       (pc & ~PAGE_MASK);
+					}
+				}
+			}
+		}
+	}
+	mmap_read_unlock(mm);
+
+	pr_err("DIAG sigill: phys=%pa pfn=%lx\n",
+	       &phys, (unsigned long)(phys >> PAGE_SHIFT));
+
+	for (i = 0; i < 8; i++) {
+		u32 v;
+
+		if (get_user(v, (u32 __user *)(pc - 16 + i * 4)))
+			break;
+		buf[i] = v;
+		n++;
+	}
+	if (n) {
+		pr_err("DIAG sigill: insn around pc (pc-16 first):\n");
+		for (i = 0; i < n; i++)
+			pr_cont(" %08x", buf[i]);
+		pr_cont("\n");
+	}
+}
+
 void force_signal_inject(int signal, int code, unsigned long address, unsigned long err)
 {
 	const char *desc;
 	struct pt_regs *regs = current_pt_regs();
 
+	ath_diag_report_sigill(signal, code, address);
+
 	if (WARN_ON(!user_mode(regs)))
 		return;
 
@@ -452,6 +548,7 @@
 	force_signal_inject(SIGSEGV, code, addr, 0);
 }
 
+
 void do_el0_undef(struct pt_regs *regs, unsigned long esr)
 {
 	u32 insn;
