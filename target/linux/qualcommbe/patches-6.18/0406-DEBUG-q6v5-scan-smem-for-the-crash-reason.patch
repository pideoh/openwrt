DEBUG: q6v5: scan SMEM for the crash reason

Temporary instrumentation, not for upstream.

The Q6 on this board signals a fatal error but SMEM item 421, which
qcom_q6v5.c reads, holds nothing. Three attempts at guessing the cause
from behaviour have been wrong, so read the reason instead: when the
expected item is empty, walk the neighbouring items and print whichever
one holds a string.

Remove once the reason is known.

Signed-off-by: Hideo Sumi <hideo.sumi@mugops.com>
---
--- a/drivers/remoteproc/qcom_q6v5.c
+++ b/drivers/remoteproc/qcom_q6v5.c
@@ -124,9 +124,34 @@
 	msg = qcom_smem_get(QCOM_SMEM_HOST_ANY, q6v5->crash_reason, &len);
 	if (!IS_ERR(msg) && len > 0 && msg[0])
 		dev_err(q6v5->dev, "fatal error received: %s\n", msg);
-	else
+	else {
+		int id;
+
 		dev_err(q6v5->dev, "fatal error without message\n");
 
+		/* DEBUG: the crash reason is not in the item this driver
+		 * expects. Scan the neighbouring SMEM items for a printable
+		 * string so the real reason can be read once, rather than
+		 * guessed at.
+		 */
+		for (id = 400; id < 460; id++) {
+			size_t l;
+			char *m = qcom_smem_get(QCOM_SMEM_HOST_ANY, id, &l);
+
+			if (IS_ERR(m) || l == 0 || l > 512)
+				continue;
+			if (m[0] >= 0x20 && m[0] < 0x7f)
+				dev_err(q6v5->dev,
+					"DBG: smem item %d len %zu: %.120s\n",
+					id, l, m);
+			else
+				dev_err(q6v5->dev,
+					"DBG: smem item %d len %zu (non-text %02x %02x %02x %02x)\n",
+					id, l, m[0], l > 1 ? m[1] : 0,
+					l > 2 ? m[2] : 0, l > 3 ? m[3] : 0);
+		}
+	}
+
 	q6v5->running = false;
 	rproc_report_crash(q6v5->rproc, RPROC_FATAL_ERROR);
 
