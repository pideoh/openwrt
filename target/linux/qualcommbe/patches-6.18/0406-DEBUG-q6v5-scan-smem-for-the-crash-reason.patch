DEBUG: q6v5: find where the firmware writes, and look for a crash reason

Temporary instrumentation, not for upstream.

Reserving everything above 0x4e800000 stops the kernel panic, so the
firmware is writing into what was ordinary kernel RAM. On the fatal
interrupt, walk that window a megabyte at a time and report the first
pages holding anything non-zero: Linux never touches the region, so
whatever is there came from the firmware.

Also scans the SMEM items around the one qcom_q6v5.c reads, which
established that this firmware records no crash reason at all -- only
item 417 exists and it is four zero bytes.

Remove both once the address is known.

Signed-off-by: Hideo Sumi <hideo.sumi@mugops.com>
---
--- a/drivers/remoteproc/qcom_q6v5.c
+++ b/drivers/remoteproc/qcom_q6v5.c
@@ -124,9 +124,67 @@
 	msg = qcom_smem_get(QCOM_SMEM_HOST_ANY, q6v5->crash_reason, &len);
 	if (!IS_ERR(msg) && len > 0 && msg[0])
 		dev_err(q6v5->dev, "fatal error received: %s\n", msg);
-	else
+	else {
+		phys_addr_t base = 0x4e780000, end = 0x5c000000, a;
+		int hits = 0, id;
+
 		dev_err(q6v5->dev, "fatal error without message\n");
 
+		/* DEBUG: find where the firmware has been writing. The board
+		 * DT fences off everything from 0x4e800000 up purely so this
+		 * scan has something stable to look at: Linux never touches
+		 * the region, so whatever is non-zero here came from the
+		 * firmware.
+		 */
+		for (a = base; a < end && hits < 40; a += SZ_1M) {
+			void __iomem *m = ioremap(a, SZ_4K);
+			u32 first = 0, nonzero = 0;
+			int k;
+
+			if (!m)
+				continue;
+			for (k = 0; k < SZ_4K / 4; k++) {
+				u32 v = readl(m + k * 4);
+
+				if (v) {
+					if (!nonzero)
+						first = v;
+					nonzero++;
+				}
+			}
+			iounmap(m);
+			if (nonzero) {
+				dev_err(q6v5->dev,
+					"DBG: written at %pa: %u/%u words, first 0x%08x\n",
+					&a, nonzero, SZ_4K / 4, first);
+				hits++;
+			}
+		}
+		if (!hits)
+			dev_err(q6v5->dev, "DBG: 0x4e780000-0x5c000000 all zero\n");
+
+		/* DEBUG: the crash reason is not in the item this driver
+		 * expects. Scan the neighbouring SMEM items for a printable
+		 * string, to see whether the firmware records one at all.
+		 */
+		for (id = 400; id < 460; id++) {
+			size_t l;
+			char *msg2 = qcom_smem_get(QCOM_SMEM_HOST_ANY, id, &l);
+
+			if (IS_ERR(msg2) || l == 0 || l > 512)
+				continue;
+			if (msg2[0] >= 0x20 && msg2[0] < 0x7f)
+				dev_err(q6v5->dev,
+					"DBG: smem item %d len %zu: %.120s\n",
+					id, l, msg2);
+			else
+				dev_err(q6v5->dev,
+					"DBG: smem item %d len %zu (non-text %02x %02x %02x %02x)\n",
+					id, l, msg2[0], l > 1 ? msg2[1] : 0,
+					l > 2 ? msg2[2] : 0, l > 3 ? msg2[3] : 0);
+		}
+	}
+
 	q6v5->running = false;
 	rproc_report_crash(q6v5->rproc, RPROC_FATAL_ERROR);
 
