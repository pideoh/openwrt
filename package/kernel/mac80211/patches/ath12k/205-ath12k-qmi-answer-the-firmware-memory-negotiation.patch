ath12k: qmi: do not drop memory regions the device tree describes

The fixed-memory path handles four region types and lets the rest fall
through to default:, which logs and breaks without incrementing idx.
mem_seg_count is then taken from idx, so an unhandled region is dropped
from the reply entirely: the firmware asks for it, is told nothing, and
is left to place it wherever its own defaults say.

MLO_GLOBAL_MEM is one of the unhandled types, and ipq5332.dtsi hands
the wifi node mlo_global_mem as memory-region[3] that nothing reads.
The firmware on this board does not request it -- instrumented and
confirmed, it asks only for 256 KiB of BDF and 1 MiB of M3 dump -- so
this changes nothing here. Silently dropping a region the device tree
describes is still wrong.

The requested chunks are also logged unconditionally while the WLAN
bring-up is being worked out; that should come out afterwards.

Signed-off-by: Hideo Sumi <hideo.sumi@mugops.com>
---
--- a/drivers/net/wireless/ath/ath12k/qmi.c
+++ b/drivers/net/wireless/ath/ath12k/qmi.c
@@ -2783,6 +2783,43 @@
 			ab->qmi.target_mem[idx].type = ab->qmi.target_mem[i].type;
 			idx++;
 			break;
+		case MLO_GLOBAL_MEM_REGION_TYPE:
+			/* ipq5332.dtsi hands wifi0 mlo_global_mem as
+			 * memory-region[3], but the fixed-memory path had no case
+			 * for it: the chunk fell through to default, and because
+			 * idx is not incremented and mem_seg_count is taken from
+			 * idx, it was dropped from the reply entirely.
+			 *
+			 * The firmware on this board does not ask for it, so this
+			 * changes nothing here; it is wrong to silently drop a
+			 * region the device tree describes.
+			 */
+			rmem = ath12k_core_get_reserved_mem(ab, 3);
+			if (!rmem) {
+				ret = -EINVAL;
+				goto out;
+			}
+
+			if (rmem->size < ab->qmi.target_mem[i].size) {
+				ath12k_warn(ab, "mlo region too small: have %zu want %u\n",
+					    (size_t)rmem->size,
+					    ab->qmi.target_mem[i].size);
+				ret = -EINVAL;
+				goto out;
+			}
+
+			ab->qmi.target_mem[idx].paddr = rmem->base;
+			ab->qmi.target_mem[idx].v.ioaddr =
+				ioremap(ab->qmi.target_mem[idx].paddr,
+					ab->qmi.target_mem[i].size);
+			if (!ab->qmi.target_mem[idx].v.ioaddr) {
+				ret = -EIO;
+				goto out;
+			}
+			ab->qmi.target_mem[idx].size = ab->qmi.target_mem[i].size;
+			ab->qmi.target_mem[idx].type = ab->qmi.target_mem[i].type;
+			idx++;
+			break;
 		case M3_DUMP_REGION_TYPE:
 			rmem = ath12k_core_get_reserved_mem(ab, 1);
 			if (!rmem) {
@@ -3686,6 +3723,8 @@
 		ab->qmi.target_mem[i].size = msg->mem_seg[i].size;
 		ath12k_dbg(ab, ATH12K_DBG_QMI, "qmi mem seg type %d size %d\n",
 			   msg->mem_seg[i].type, msg->mem_seg[i].size);
+		ath12k_warn(ab, "DBG: fw requests mem type %u size %u\n",
+			    msg->mem_seg[i].type, msg->mem_seg[i].size);
 	}
 
 	if (test_bit(ATH12K_FLAG_FIXED_MEM_REGION, &ab->dev_flags)) {
