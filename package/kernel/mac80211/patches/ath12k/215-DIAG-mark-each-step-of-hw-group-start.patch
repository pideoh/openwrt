DIAG: ath12k: mark hw_group_start's steps and sleep before pdev_create

Temporary, not for upstream.

Sleeping in front of ath12k_hif_irq_enable() put the fault inside the
sleep, 243 ms in, so the datapath going live is not the trigger. Measured
from ath12k_core_pdev_create the delay is the same every time: 246 ms,
then 243 ms.

Sleep in front of pdev_create to split it from mac_register. A fault
inside the sleep means mac_register armed it; surviving the sleep means
pdev_create, which is where ath12k_dp_rx_htt_setup sends the HTT ring
configuration and ath12k_dp_rx_pdev_alloc posts the first RX buffers.

Signed-off-by: Hideo Sumi <hideo.sumi@mugops.com>
---
--- a/drivers/net/wireless/ath/ath12k/core.c
+++ b/drivers/net/wireless/ath/ath12k/core.c
@@ -1162,14 +1162,17 @@
 	if (test_bit(ATH12K_GROUP_FLAG_REGISTERED, &ag->flags))
 		goto core_pdev_create;
 
+	pr_warn("ath12k DBG: grp[00] ath12k_mac_allocate\n");
 	ret = ath12k_mac_allocate(ag);
 	if (WARN_ON(ret))
 		return ret;
 
+	pr_warn("ath12k DBG: grp[01] ath12k_core_mlo_setup\n");
 	ret = ath12k_core_mlo_setup(ag);
 	if (WARN_ON(ret))
 		goto err_mac_destroy;
 
+	pr_warn("ath12k DBG: grp[02] ath12k_mac_register\n");
 	ret = ath12k_mac_register(ag);
 	if (WARN_ON(ret))
 		goto err_mlo_teardown;
@@ -1186,6 +1189,10 @@
 
 		set_bit(ATH12K_FLAG_REGISTERED, &ab->dev_flags);
 
+		pr_warn("ath12k DBG: before ath12k_core_pdev_create, sleeping 6s\n");
+		msleep(6000);
+		pr_warn("ath12k DBG: survived, ath12k_core_pdev_create now\n");
+		pr_warn("ath12k DBG: grp[03] ath12k_core_pdev_create\n");
 		ret = ath12k_core_pdev_create(ab);
 		if (ret) {
 			ath12k_err(ab, "failed to create pdev core %d\n", ret);
@@ -1193,8 +1200,10 @@
 			goto err;
 		}
 
+		pr_warn("ath12k DBG: grp[04] ath12k_hif_irq_enable\n");
 		ath12k_hif_irq_enable(ab);
 
+		pr_warn("ath12k DBG: grp[05] ath12k_core_rfkill_config\n");
 		ret = ath12k_core_rfkill_config(ab);
 		if (ret && ret != -EOPNOTSUPP) {
 			mutex_unlock(&ab->core_lock);
@@ -1204,6 +1213,7 @@
 		mutex_unlock(&ab->core_lock);
 	}
 
+	pr_warn("ath12k DBG: grp[END] hw_group_start done\n");
 	return 0;
 
 err:
