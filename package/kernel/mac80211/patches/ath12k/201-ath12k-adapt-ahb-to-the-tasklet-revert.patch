From 2ad89c075a830162b7ea56514cd1ae5ba493b07e Mon Sep 17 00:00:00 2001
From: Hideo Sumi <hideo.sumi@mugops.com>
Date: Tue, 1 Sep 2026 20:23:13 +0900
Subject: [PATCH] ath12k: adapt ahb.c to the reverted tasklet API

Patch 200 reverts commit cdad737160571a98cc4933a62c9f2728e965ab27 for
ce.h and pci.c, restoring struct ath12k_ce_pipe's tasklet member. ahb.c
was added to the driver after that conversion had already landed, so it
has only ever existed in the workqueue form and the revert does not
cover it. This is a forward adaptation to the local revert rather than a
revert itself.

Nothing notices today because no target selects ATH12K_AHB, which means
ahb.c is never compiled. Selecting it fails the build immediately:

  ahb.c:655:37: error: 'struct ath12k_ce_pipe' has no member named
                'intr_wq'; did you mean 'intr_tq'?

Convert ahb.c's CE interrupt handling to the tasklet form so both bus
backends agree on the struct member, and rename
ath12k_ahb_cancel_workqueue() to ath12k_ahb_kill_tasklets() to match the
ath12k_pci_kill_tasklets() that patch 200 restores.
---
--- a/drivers/net/wireless/ath/ath12k/ahb.c
+++ b/drivers/net/wireless/ath/ath12k/ahb.c
@@ -137,7 +137,7 @@
 		iowrite32(value, ab->mem + offset);
 }
 
-static void ath12k_ahb_cancel_workqueue(struct ath12k_base *ab)
+static void ath12k_ahb_kill_tasklets(struct ath12k_base *ab)
 {
 	int i;
 
@@ -147,7 +147,7 @@
 		if (ath12k_ce_get_attr_flags(ab, i) & CE_ATTR_DIS_INTR)
 			continue;
 
-		cancel_work_sync(&ce_pipe->intr_wq);
+		tasklet_kill(&ce_pipe->intr_tq);
 	}
 }
 
@@ -326,7 +326,7 @@
 	if (!test_bit(ATH12K_FLAG_CRASH_FLUSH, &ab->dev_flags))
 		ath12k_ahb_ce_irqs_disable(ab);
 	ath12k_ahb_sync_ce_irqs(ab);
-	ath12k_ahb_cancel_workqueue(ab);
+	ath12k_ahb_kill_tasklets(ab);
 	timer_delete_sync(&ab->rx_replenish_retry);
 	ath12k_ce_cleanup_pipes(ab);
 }
@@ -503,9 +503,9 @@
 	ab->qmi.service_ins_id = ab->hw_params->qmi_service_ins_id;
 }
 
-static void ath12k_ahb_ce_workqueue(struct work_struct *work)
+static void ath12k_ahb_ce_tasklet(struct tasklet_struct *t)
 {
-	struct ath12k_ce_pipe *ce_pipe = from_work(ce_pipe, work, intr_wq);
+	struct ath12k_ce_pipe *ce_pipe = from_tasklet(ce_pipe, t, intr_tq);
 
 	ath12k_ce_per_engine_service(ce_pipe->ab, ce_pipe->pipe_num);
 
@@ -521,7 +521,7 @@
 
 	ath12k_ahb_ce_irq_disable(ce_pipe->ab, ce_pipe->pipe_num);
 
-	queue_work(system_bh_wq, &ce_pipe->intr_wq);
+	tasklet_schedule(&ce_pipe->intr_tq);
 
 	return IRQ_HANDLED;
 }
@@ -652,7 +652,7 @@
 
 		irq_idx = ATH12K_IRQ_CE0_OFFSET + i;
 
-		INIT_WORK(&ce_pipe->intr_wq, ath12k_ahb_ce_workqueue);
+		tasklet_setup(&ce_pipe->intr_tq, ath12k_ahb_ce_tasklet);
 		irq = platform_get_irq_byname(ab->pdev, irq_name[irq_idx]);
 		ret = devm_request_irq(ab->dev, irq, ath12k_ahb_ce_interrupt_handler,
 				       IRQF_TRIGGER_RISING, irq_name[irq_idx],
